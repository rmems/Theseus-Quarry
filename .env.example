# Theseus-Quarry — Mining Environment Configuration Template
#
# Preferred location (secrets stay out of the git tree):
#   cp .env.example ~/.config/theseus-quarry/mining.env
#   chmod 600 ~/.config/theseus-quarry/mining.env
#
# Optional local override (gitignored):
#   cp .env.example .env
#
# Machine-specific binaries/RPC secrets:
#   cp binaries.env.example ~/.config/theseus-quarry/binaries.env
#
# NEVER commit real env files.

# ===========================================
# QUAI MINING CONFIGURATION
# ===========================================
QUAI_WALLET_ADDRESS=0xYOUR_QUAI_WALLET
QUAI_POOL=stratum+tcp://127.0.0.1:7071
QUAI_WORKER_NAME=your-worker
QUAI_MINING_THREADS=8
QUAI_MINER_CMD=/path/to/rigel
QUAI_DATA_DIR=/path/to/go-quai/data
# Node RPC endpoint for telemetry polling
QUAI_NODE_RPC_URL=http://127.0.0.1:9001

# ===========================================
# QUBIC MINING CONFIGURATION
# ===========================================
QUBIC_WALLET_ADDRESS=YOUR_QUBIC_WALLET
QUBIC_MINING_MODE=solo_pool
QUBIC_MINING_POOL_URL=https://pool.qubic.li
QUBIC_MINING_THREADS=16
QUBIC_MINER_CMD=/path/to/qli-Client
# Node RPC endpoint for telemetry polling (canonical name)
QUBIC_NODE_API_URL=http://127.0.0.1:8099

# ===========================================
# DYNEX MINING CONFIGURATION
# ===========================================
DYNEX_WALLET_ADDRESS=YOUR_DYNEX_WALLET
SHIP_WALLET=solo:YOUR_DYNEX_WALLET
DYNEX_POOL_PRIMARY=dnx.eu.neuropool.net:19330
DYNEX_WORKER=your-worker
# OneZeroMiner local HTTP API port (collector MinerPerf)
DYNEX_API_PORT=3010
# Node RPC endpoint for telemetry polling
DYNEX_NODE_RPC_URL=http://127.0.0.1:17336

# ===========================================
# KASPA MINING CONFIGURATION
# ===========================================
KASPA_WALLET_ADDRESS=kaspa:YOUR_KASPA_WALLET
# BzMiner local HTTP API port (collector MinerPerf)
KASPA_API_PORT=4014

# ===========================================
# MONERO MINING CONFIGURATION
# ===========================================
MONERO_WALLET_ADDRESS=YOUR_MONERO_WALLET
# XMRig/SRBMiner local HTTP API port (collector MinerPerf)
MONERO_API_PORT=4015
# Node RPC endpoint for telemetry polling
MONERO_NODE_RPC_URL=http://127.0.0.1:18081/json_rpc

# ===========================================
# VERUS COIN CONFIGURATION
# ===========================================
VRSC_WALLET_ADDRESS=YOUR_VERUS_WALLET
# VRSC_RPC_PASSWORD and VRSC_WALLET_PRIVKEY go in ~/.config/theseus-quarry/binaries.env
