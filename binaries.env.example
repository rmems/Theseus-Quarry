# Binaries Environment — secrets and machine-specific config
# Copy this to ~/.config/theseus-quarry/binaries.env and fill in your values.
# NEVER commit the real file to version control.

# ===========================================
# VERUS COIN SECRETS
# ===========================================
VRSC_RPC_PASSWORD=your-rpc-password
VRSC_WALLET_PRIVKEY=your-private-key

# ===========================================
# VERUS DAEMON PATHS
# ===========================================
VRSC_DAEMON_BIN=/path/to/verusd
VRSC_MINER_BIN=/path/to/hellminer

# ===========================================
# QUBIC MINER PATH
# ===========================================
QUBIC_MINER_CMD=/path/to/qli-Client

# ===========================================
# TELEMETRY GOVERNOR CONFIG
# ===========================================
# Comma-separated list of miner executable names that the telemetry-collector 
# is allowed to suspend (SIGSTOP) during thermal or VRAM emergencies.
# Default covers standard miners, but you can add your custom SNN/ML binaries here.
GOVERNED_MINERS=bzminer,xmrig,onezerominer,rigel,qli-Client,hellminer,SRBMiner-MULTI

# ===========================================
# KASPA MINER PATH
# ===========================================
KASPA_MINER_CMD=/path/to/kaspad

# ===========================================
# MONERO WALLET PATH
# ===========================================
MONERO_WALLET_PATH=/path/to/monero/wallet

# ===========================================
# ALIBABA CLOUD (optional)
# ===========================================
DASHSCOPE_API_KEY=your-api-key
ALIBABA_ACCESS_KEY_ID=your-access-key-id
ALIBABA_ACCESS_KEY_SECRET=your-access-key-secret
